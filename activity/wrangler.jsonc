{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "virtual-office-recorder",
  "main": "./server/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
