{
  "name": "bot",
  "private": true,
  "description": "Posts to Slack when the Discord virtual office voice channel opens or empties, plus a weekday reminder",
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "dev": "node --env-file=../../.env src/main.ts",
    "start": "node --env-file=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "node scripts/deploy.ts"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@effect/ai-openai-compat": "catalog:",
    "@effect/ai-openrouter": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@sentry/effect": "11.8.0",
    "@snazzah/davey": "0.1.12",
    "discord.js": "14.27.0",
    "effect": "catalog:",
    "recording-requests": "workspace:*"
  },
  "devDependencies": {
    "@effect/sql-pglite": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "26.6.5",
    "rolldown": "1.2.14",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
