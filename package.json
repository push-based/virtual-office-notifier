{
  "name": "virtual-office-notifier",
  "private": true,
  "description": "Posts to Slack when the Discord virtual office voice channel opens or empties, and records the office on demand from a Discord Activity",
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "prepare": "effect-tsgo patch --typescript"
  },
  "author": "Christopher Holder",
  "license": "0BSD",
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "26.6.5",
    "oxlint": "1.89.0",
    "typescript": "7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  }
}
